# Environment
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# Security
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/visionforensics

# Storage paths (relative to backend/)
UPLOAD_DIR=uploads
PROCESSED_DIR=processed
REPORTS_DIR=reports
HEATMAPS_DIR=heatmaps

# Upload limits
MAX_FILE_SIZE_MB=20

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
