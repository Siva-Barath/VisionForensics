# =============================================================================
# VisionForensics AI — Controlled Pilot Environment Configuration Template
# COPY THIS FILE TO '.env.pilot' AND POPULATE SECURE PASSWORDS BEFORE STARTUP
# DO NOT COMMIT REAL PRODUCTION OR PILOT CREDENTIALS TO VERSION CONTROL
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Application Runtime Settings
# -----------------------------------------------------------------------------
APP_ENV=pilot
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_RANDOM_HEX_64_CHARS

# -----------------------------------------------------------------------------
# 2. Authentication & Session Lifecycles
# -----------------------------------------------------------------------------
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_GRACE_WINDOW_SECONDS=15

# -----------------------------------------------------------------------------
# 3. PostgreSQL Database Connections (Least-Privilege Role Separation)
# -----------------------------------------------------------------------------
# PostgreSQL superuser (used for initial container initialization only)
POSTGRES_DB=visionforensics
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD

# Application Runtime User (DML ONLY: SELECT, INSERT, UPDATE, DELETE on app tables)
# Append-only custody logs restrict UPDATE/DELETE automatically
DATABASE_URL=postgresql://visionforensics_app:REPLACE_WITH_APP_ROLE_PASSWORD@postgres:5432/visionforensics

# Migrator Role (DDL ONLY: Used strictly for Alembic schema migrations)
MIGRATION_DATABASE_URL=postgresql://visionforensics_migrator:REPLACE_WITH_MIGRATOR_ROLE_PASSWORD@postgres:5432/visionforensics

# -----------------------------------------------------------------------------
# 4. Storage Directories (Container Paths)
# -----------------------------------------------------------------------------
UPLOAD_DIR=/app/uploads
PROCESSED_DIR=/app/processed
REPORTS_DIR=/app/reports
HEATMAPS_DIR=/app/heatmaps

# -----------------------------------------------------------------------------
# 5. Resource Constraints & Upload Limits
# -----------------------------------------------------------------------------
MAX_FILE_SIZE_MB=20
MAX_IMAGE_DIMENSION=10000
MAX_PDF_PAGES=50

# -----------------------------------------------------------------------------
# 6. Defensive Rate Limiting & Account Lockout
# -----------------------------------------------------------------------------
RATE_LIMIT_AUTH_REQUESTS=5
RATE_LIMIT_UPLOAD_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ACCOUNT_MAX_FAILURES=5
RATE_LIMIT_ACCOUNT_LOCKOUT_SECONDS=900

# -----------------------------------------------------------------------------
# 7. Network Access, Trusted Proxies & CORS
# -----------------------------------------------------------------------------
# Trusted Proxy IPs allowed to set X-Forwarded-For headers (Exact Nginx IP 172.28.0.10 & localhost)
TRUSTED_PROXIES=172.28.0.10,127.0.0.1

# Permitted Web Origins (Explicit pilot HTTPS URLs only; NO development or unencrypted HTTP origins)
ALLOWED_ORIGINS=https://localhost:8443,https://pilot.visionforensics.local:8443,https://pilot.visionforensics.local

# External Ports exposed by Nginx reverse proxy on the host
PILOT_HTTP_PORT=8080
PILOT_HTTPS_PORT=8443

# -----------------------------------------------------------------------------
# 8. Cryptographic Backup Authentication Key
# -----------------------------------------------------------------------------
# HMAC-SHA256 signing key for authenticating backup manifests.
# MUST BE STORED SEPARATELY FROM BACKUP STORAGE (e.g. in secret manager or orchestrator vault).
# Generate with: openssl rand -hex 32
BACKUP_HMAC_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_HMAC_HEX_KEY
